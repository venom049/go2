{
  "policy_class_name": "HIMActorCritic",
  "algorithm_class_name": "HIMPPO",
  "logger": "tensorboard",
  "num_steps_per_env": 24,
  "save_interval": 100,
  "seed": 42,
  "device": "cuda:0",
  "policy": {
    "actor_hidden_dims": [
      512,
      256,
      128
    ],
    "critic_hidden_dims": [
      512,
      256,
      128
    ],
    "activation": "elu",
    "init_noise_std": 0.2,
    "min_noise_std": 0.05,
    "max_noise_std": 0.4
  },
  "algorithm": {
    "value_loss_coef": 1.0,
    "use_clipped_value_loss": true,
    "clip_param": 0.2,
    "entropy_coef": 0.001,
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "learning_rate": 0.0001,
    "schedule": "adaptive",
    "min_learning_rate": 1e-05,
    "max_learning_rate": 0.001,
    "action_clip": 4.0,
    "action_mean_penalty_coef": 0.01,
    "gamma": 0.99,
    "lam": 0.95,
    "desired_kl": 0.01,
    "max_grad_norm": 1.0
  }
}