<?xml version="1.0"?>
  <robot name="go2_camera_mount">

    <link name="base_link"/>

    <link name="camera_link"/>

    <joint name="base_to_camera" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="0.33 0.0 0.04" rpy="0 0 0"/>
    </joint>

  </robot>
